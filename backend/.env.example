# --- required for campaigns ---
GOOGLE_CLIENT_IDS=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com   # comma separated; must match the app's serverClientId (ID token audience)
SESSION_SECRET=change-me-to-a-long-random-string-32+chars
PAYSTACK_SECRET_KEY=sk_live_xxx
PAYSTACK_CURRENCY=USD             # must be enabled on your Paystack account (else use NGN/GHS/ZAR/KES and adjust prices)
PUBLIC_BASE_URL=https://api.yourdomain.com   # used for the Paystack callback page
# --- optional ---
ADS_MAX_UPLOAD_MB=200
VIDTUBE_DATA=/var/lib/vidtube
